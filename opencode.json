{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "instructions": ["AGENTS.md"],
  "agent": {
    "fhe-architect": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "max"
    },
    "fhe-implementer": {
      "model": "opencode-go/deepseek-v4-pro",
      "variant": "max"
    },
    "fhe-crypto-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high"
    },
    "fhe-math-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high"
    },
    "fhe-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high"
    }
  },
  "permission": {
    "bash": {
      "cargo test *": "allow",
      "cargo build *": "allow",
      "cargo run *": "allow",
      "cargo clippy *": "allow",
      "cargo fmt *": "allow",
      "cargo bench *": "allow",
      "cargo check *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "*": "ask"
    }
  }
}
