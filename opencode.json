{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "cargo test *": "allow",
      "cargo build *": "allow",
      "cargo run *": "allow",
      "cargo clippy *": "allow",
      "cargo fmt *": "allow",
      "cargo bench *": "allow",
      "cargo check *": "allow",
      "pre-commit *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "*": "ask"
    }
  }
}
