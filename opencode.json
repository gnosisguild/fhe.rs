{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "instructions": ["AGENTS.md"],
  "permission": {
    "external_directory": "deny",
    "bash": {
      "cargo test *": "allow",
      "cargo build *": "allow",
      "cargo run *": "allow",
      "cargo clippy *": "allow",
      "cargo fmt *": "allow",
      "cargo bench *": "allow",
      "cargo check *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git checkout *": "allow",
      "git branch *": "allow",
      "*": "ask"
    }
  },
  "agent": {
    "orchestrator": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "low",
      "variant": "low"
    },
    "architect": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "variant": "high"
    },
    "triage": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "high",
      "variant": "high"
    },
    "planner": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "low",
      "variant": "low"
    },
    "implementer": {
      "model": "opencode-go/deepseek-v4-pro",
      "reasoningEffort": "medium",
      "variant": "medium"
    },
    "guard-reviewer": {
      "model": "opencode-go/deepseek-v4-pro",
      "reasoningEffort": "low",
      "variant": "low"
    },
    "quality-reviewer": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "high",
      "variant": "high"
    },
    "crypto-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "variant": "high"
    },
    "math-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "variant": "high"
    },
    "harness": {
      "model": "opencode-go/deepseek-v4-pro",
      "reasoningEffort": "high",
      "variant": "high"
    }
  }
}
